# MikroMan environment configuration - OPTIONAL.
#
# This file is NOT used by the Docker deployment: docker-compose.yml declares no
# env_file, and .env is excluded from the image. It is read only when running the
# backend directly from the repository root.
#
# Everything here can also be configured through the setup wizard, which stores
# it in the database. Prefer the wizard.

# --- RouterOS connection (optional; the wizard is the normal route) ---
# Used only when no router has been configured in the database. Leaving
# ROUTEROS_PASSWORD empty means "no credentials supplied": the app will not
# attempt a login rather than guessing at one, so it never appears in the
# router's log as a failed admin login.
ROUTEROS_HOST=192.168.88.1
ROUTEROS_PORT=443
ROUTEROS_USE_SSL=true
ROUTEROS_SSL_VERIFY=false
# Set to the RouterOS user you created for the API. There is no default on
# purpose - do not put "admin" here unless that is genuinely the account.
ROUTEROS_USER=
ROUTEROS_PASSWORD=

# --- Polling & telemetry ---
# Both are also adjustable at runtime in Settings.
POLL_INTERVAL_SECONDS=10
TELEMETRY_STREAM_INTERVAL_SECONDS=1.0

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_DEFAULT_LANG=en

# --- Application & database ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DEBUG=false
