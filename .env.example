# MikroMan environment configuration - OPTIONAL.
#
# This file is NOT used by the Docker deployment: docker-compose.yml declares no
# env_file, and .env is excluded from the image. It is read only when running the
# backend directly from the repository root.
#
# Everything here can also be configured through the setup wizard, which stores
# it in the database. Prefer the wizard.

# --- RouterOS connection (optional; the wizard is the normal route) ---
# Used only when no router has been configured in the database. Leaving
# ROUTEROS_PASSWORD empty means "no credentials supplied": the app will not
# attempt a login rather than guessing at one, so it never appears in the
# router's log as a failed admin login.
ROUTEROS_HOST=192.168.88.1
ROUTEROS_PORT=443
ROUTEROS_USE_SSL=true
ROUTEROS_SSL_VERIFY=false
# Set to the RouterOS user you created for the API. There is no default on
# purpose - do not put "admin" here unless that is genuinely the account.
ROUTEROS_USER=
ROUTEROS_PASSWORD=

# --- Polling & telemetry ---
# Both are also adjustable at runtime in Settings.
#
# POLL_INTERVAL_SECONDS drives the telemetry half of the background tick: the
# hardware and bandwidth samples behind the graphs (4 REST calls per router).
# HEAVY_SYNC_INTERVAL_SECONDS drives the expensive half - device discovery,
# simple-queue and mangle-counter reconciliation, rollups, quota checks - which
# costs a dozen or more calls per router for state that rarely moves. Limits and
# pauses applied from the UI take effect immediately either way, so lowering the
# heavy interval only changes how soon a *newly joined* device is noticed.
POLL_INTERVAL_SECONDS=10
HEAVY_SYNC_INTERVAL_SECONDS=60
# 3 s matches what the Settings dialog labels "recommended"; the code default is
# the same. Each open dashboard tab pays this interval in router reads.
TELEMETRY_STREAM_INTERVAL_SECONDS=3.0

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_DEFAULT_LANG=en

# --- Application & database ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DEBUG=false

# --- Application log ---
# MikroMan writes its own log next to the database (so in a container, on the
# mounted storage) and rotates it. Readable in the UI under System Events ->
# MikroMan Log, or GET /api/v1/logs?source=app. A data directory that cannot be
# written to falls back to console logging; the app still starts.
LOG_TO_FILE=true
LOG_FILE_MAX_BYTES=4000000
LOG_FILE_BACKUP_COUNT=3
